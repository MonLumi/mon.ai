{
  "name": "mon-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal AI ops assistant (Zendesk, Cloudflare, Azure/ADO, local git) served on mon.ai (localhost only)",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch-path=server.js --watch-path=lib server.js",
    "cert": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/make-cert.ps1",
    "bg": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/mon.ps1 start",
    "restart": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/mon.ps1 restart",
    "stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/mon.ps1 stop",
    "status": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/mon.ps1 status",
    "shortcuts": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcuts.ps1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "dompurify": "^3.5.0",
    "express": "^4.22.3",
    "marked": "^15.0.12",
    "zod": "^4.6.7"
  }
}
